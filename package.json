{
  "name": "dpchamps-pi-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Custom skills and extensions for the pi coding agent",
  "keywords": [
    "pi-package",
    "thinking",
    "reasoning"
  ],
  "author": "dpchamps",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "extensions/*",
    "skills/*"
  ],
  "pi": {
    "extensions": [
      "./extensions",
      "!extensions/autorouter",
      "!extensions/autorouter/**",
      "!extensions/thinking-tool",
      "!extensions/thinking-tool/**"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:web-fetch": "cd extensions/web-fetch-tool && npx vitest run",
    "test:runinfra": "cd extensions/runinfra && npx vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^25.6.0",
    "prettier": "^3.8.3",
    "typebox": "1.3.27",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
